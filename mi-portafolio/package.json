{
  "name": "mi-portafolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Portafolio personal con React + Vite y backend Node.js/Express para proyectos.",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.js",
    "dev:all": "concurrently -k -n client,server -c blue,green \"npm:dev\" \"npm:dev:server\"",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "engines": {
    "node": "24.x"
  },
  "author": "Tu Nombre",
  "license": "MIT",
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@hookform/resolvers": "^5.9.1",
    "express": "^5.3.0",
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "three": "^0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
