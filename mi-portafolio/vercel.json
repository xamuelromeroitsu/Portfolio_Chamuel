{
  "functions": {
    "server/index.js": {
      "runtime": "node@24.0.0"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "dist/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
