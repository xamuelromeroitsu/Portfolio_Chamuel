{
  "routes": [
    {
      "src": "/asignacion-01",
      "dest": "/asignacion-01/index.html"
    },
    {
      "src": "/asignacion-02",
      "dest": "/asignacion-02/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "dist/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
